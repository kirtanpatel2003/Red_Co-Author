# Red_Co-Author environment template.
#
# To enable Laminar tracing:
#   1. Copy this file:        cp .env.example .env
#   2. Sign up at https://www.lmnr.ai (free cloud tier) or self-host
#   3. Paste your project API key after LMNR_PROJECT_API_KEY= below
#   4. Restart the Streamlit app or the CLI
#
# `.env` is gitignored. The committed `.env.example` you are reading has
# no key in it, so it is safe to share publicly.
#
# When LMNR_PROJECT_API_KEY is unset or blank, the pipeline still runs;
# every `@observe` decorator becomes a no-op and nothing leaves the
# machine.

LMNR_PROJECT_API_KEY=
